# Copy to .env and fill in. Every NEXT_PUBLIC_* value is inlined at BUILD
# time, so this file must be correct before `npm run build` — setting them in
# a process manager's runtime environment has no effect on an already-built
# bundle.

# Express API. The server-only value is used by server components and route
# handlers; the public one is what the browser calls and is also what
# next.config.mjs derives its next/image remotePattern from, so a wrong host
# here shows up as images that refuse to render.
API_URL=https://global.strsltd.com/api/v1
NEXT_PUBLIC_API_URL=https://global.strsltd.com/api/v1

# Name of the signed admin session cookie. Must match ADMIN_COOKIE_NAME in
# str-backend, or /admin authenticates against a cookie nobody sets.
ADMIN_COOKIE_NAME=str_admin

# ⚑ CRAWLABILITY. app/robots.js serves `Disallow: /` for ANY value other than
# exactly "production". Use "production" on the live host only; anything else
# — "staging", "preview", your own name — blocks crawlers, which is what you
# want everywhere that is not strsltd.com. next.config.mjs refuses to run a
# production build if this is missing entirely.
NEXT_PUBLIC_SITE_ENV=staging

# Google Tag Manager container. Leave blank to mount nothing at all: no
# container, no consent shim, no noscript frame. Set it on the live host.
NEXT_PUBLIC_GTM_ID=
