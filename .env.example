# ─── BFF → Express ────────────────────────────────────────
# Server-side only. The Next route handlers talk to this. Never exposed to the
# browser. If it is unset, lib/apiServer.js throws at module load rather than
# guessing localhost — a silent fallback in production is a 30-second outage
# that looks like a 3-hour one.
API_URL=http://localhost:5025/api/v1

# Exposed to the browser. Used ONLY by the public contact form, which posts
# directly to Express so the per-IP rate limiter keys on the real visitor.
NEXT_PUBLIC_API_URL=http://localhost:5025/api/v1

# ─── Session cookie ───────────────────────────────────────
# Name of the cookie THIS app sets. Distinct from the backend's str_token on
# purpose — they are different cookies on different origins.
ADMIN_COOKIE_NAME=str_admin
